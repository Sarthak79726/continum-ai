# ==============================================================================
# CONTINUUM AI — ENVIRONMENT CONFIGURATION & SECURITY BLUEPRINT
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
# In production, startup checks will abort if default secret keys or wildcard CORS are detected.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite database with zero external setup required
# Production: postgresql+psycopg2://user:password@hostname:5432/continuum_ai
DATABASE_URL=sqlite:///./continuum_ai.db

# ------------------------------------------------------------------------------
# Authentication, JWT & Session Hardening
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=continuum-ai-super-secret-key-change-in-production-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Rate Limiting & Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# Network, CORS & Origin Restrictions
# ------------------------------------------------------------------------------
# Comma-separated list of trusted origins (wildcards '*' forbidden in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# AI Engine & Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: demo, gemini, openai, anthropic, groq, ollama
# Note: Paid API keys are NEVER required to run or evaluate Continuum AI.
# 'demo' mode utilizes the high-precision deterministic local NLP engine.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# File Storage & Upload Protection
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_data
UPLOAD_DIRECTORY=./uploads
# Maximum upload size in bytes (20 MB default)
MAX_UPLOAD_SIZE=20971520
