# Continuum AI — Environment Configuration

# Database (Default: SQLite local database with zero setup)
DATABASE_URL=sqlite:///./continuum_ai.db

# JWT Security
JWT_SECRET_KEY=continuum-ai-super-secret-key-change-in-production-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported providers: demo, gemini, openai, anthropic, groq, ollama
# Note: Paid API keys are NEVER required to run or test Continuum AI.
# 'demo' mode uses the high-precision deterministic local NLP engine.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Directories
CHROMA_PERSIST_DIRECTORY=./chroma_data
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=20971520

